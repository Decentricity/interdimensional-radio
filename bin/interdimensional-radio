#!/usr/bin/env python3
"""Interdimensional Radio — generate songs with Music3, fill gaps with interstitials."""

from __future__ import annotations

import fcntl
import hashlib
import json
import os
import random
import secrets
import shutil
import signal
import subprocess
import sys
import threading
import time
from collections.abc import Callable
from datetime import datetime, timezone
from pathlib import Path

HOME = Path.home()


def repo_root() -> Path:
    env = os.environ.get("IDR_ROOT")
    if env:
        return Path(env).expanduser().resolve()
    return Path(__file__).resolve().parent.parent


ROOT = repo_root()
sys.path.insert(0, str(ROOT / "prompts"))
import song_title  # noqa: E402
LIBRARY = ROOT / "library"
QUARANTINE = LIBRARY / "quarantine"
STAGING = ROOT / ".radio-staging"
LOCK_FILE = STAGING / "radio.lock"
INTERSTITIALS = ROOT / "interstitials" / "audio"
CAPTION = ROOT / "prompts" / "normie-control.caption.txt"
LYRICS_TEMPLATE = ROOT / "prompts" / "normie-control.lyrics.template.txt"
CATALOG = LIBRARY / "catalog.json"
WARM = ROOT / "bin" / "music3-warm"

SONG_DURATION = 120
TAIL_FADE_MAX = 2.0
INTERSTITIAL_FADE_MAX = 2.0
MIN_LIBRARY_S = 30.0
INTERSTITIAL_FILL_MAX_S = 40.0  # then play a full library track

_catalog_lock = threading.Lock()
_play_lock = threading.Lock()
_play_proc: subprocess.Popen[bytes] | None = None
_radio_lock_handle = None


def log(msg: str) -> None:
    print(msg, flush=True)


def run(cmd: list[str], **kw) -> subprocess.CompletedProcess:
    log("+ " + " ".join(cmd))
    return subprocess.run(cmd, check=True, **kw)


def duration(path: Path) -> float:
    out = subprocess.check_output(
        [
            "ffprobe",
            "-v",
            "error",
            "-show_entries",
            "format=duration",
            "-of",
            "csv=p=0",
            str(path),
        ],
        text=True,
    ).strip()
    return float(out)


def tail_fade(path: Path, out: Path, fade_max: float = TAIL_FADE_MAX) -> Path:
    dur = duration(path)
    fade = min(fade_max, max(0.35, dur * 0.12))
    start = max(0.0, dur - fade)
    run(
        [
            "ffmpeg",
            "-y",
            "-loglevel",
            "error",
            "-i",
            str(path),
            "-af",
            f"afade=t=out:st={start:.3f}:d={fade:.3f}",
            str(out),
        ]
    )
    return out


def stop_playback() -> None:
    global _play_proc
    with _play_lock:
        if _play_proc is not None and _play_proc.poll() is None:
            _play_proc.terminate()
            try:
                _play_proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                _play_proc.kill()
                _play_proc.wait(timeout=2)
        _play_proc = None


def stop_stray_radio_processes() -> None:
    """Stop orphaned playback/gen jobs left when a prior radio instance was killed."""
    patterns = ("pw-play", "music3-warm gen")
    staging = str(STAGING)
    for pattern in patterns:
        try:
            out = subprocess.check_output(["pgrep", "-af", pattern], text=True)
        except subprocess.CalledProcessError:
            continue
        for line in out.splitlines():
            if staging not in line:
                continue
            pid = int(line.split()[0])
            if pid == os.getpid():
                continue
            try:
                os.kill(pid, signal.SIGTERM)
            except ProcessLookupError:
                pass


def acquire_radio_lock() -> None:
    global _radio_lock_handle
    STAGING.mkdir(parents=True, exist_ok=True)
    handle = open(LOCK_FILE, "w", encoding="utf-8")
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        handle.close()
        log(f"another interdimensional-radio is already running (see {LOCK_FILE})")
        raise SystemExit(1)
    handle.seek(0)
    handle.truncate()
    handle.write(str(os.getpid()))
    handle.flush()
    _radio_lock_handle = handle


def release_radio_lock() -> None:
    global _radio_lock_handle
    if _radio_lock_handle is None:
        return
    fcntl.flock(_radio_lock_handle, fcntl.LOCK_UN)
    _radio_lock_handle.close()
    _radio_lock_handle = None


def play(path: Path, stop_if: Callable[[], bool] | None = None) -> bool:
    """Play audio. Returns False if stopped early via stop_if."""
    global _play_proc
    stop_playback()
    with _play_lock:
        if shutil.which("pw-play"):
            _play_proc = subprocess.Popen(["pw-play", str(path)])
        else:
            _play_proc = subprocess.Popen(["aplay", "-q", str(path)])
        while _play_proc.poll() is None:
            if stop_if and stop_if():
                _play_proc.terminate()
                try:
                    _play_proc.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    _play_proc.kill()
                    _play_proc.wait(timeout=2)
                _play_proc = None
                return False
            time.sleep(0.25)
        _play_proc = None
    return True


class SongGenerator:
    def __init__(self) -> None:
        self._lock = threading.Lock()
        self._job: threading.Thread | None = None
        self._path: Path | None = None
        self._error: str | None = None
        self._ready = threading.Event()
        self._seed = random.randint(1, 9999)
        self._started_at: float | None = None
        self._title: str | None = None

    def start(self) -> None:
        with self._lock:
            if self._job and self._job.is_alive():
                return
            self._ready.clear()
            self._path = None
            self._error = None
            self._title = None
            self._job = threading.Thread(target=self._run, daemon=True)
            self._job.start()

    def _run(self) -> None:
        STAGING.mkdir(parents=True, exist_ok=True)
        out = STAGING / f"pending-{int(time.time())}.wav"
        seed = self._seed
        self._seed += 1
        self._started_at = time.time()
        title = song_title.random_title()
        self._title = title
        log(f'generation started (seed {seed}, title "{title}")')
        prompt_dir = STAGING / "prompts"
        prompt_dir.mkdir(parents=True, exist_ok=True)
        stamp = int(time.time() * 1000)
        caption_path = prompt_dir / f"caption-{stamp}.txt"
        lyrics_path = prompt_dir / f"lyrics-{stamp}.txt"
        caption_path.write_text(song_title.build_caption(title), encoding="utf-8")
        lyrics_path.write_text(song_title.build_lyrics(title), encoding="utf-8")
        try:
            run(
                [
                    str(WARM),
                    "gen",
                    "--lyrics",
                    str(lyrics_path),
                    "--prompt",
                    str(caption_path),
                    "--duration",
                    str(SONG_DURATION),
                    "--seed",
                    str(seed),
                    "--out",
                    str(out),
                    "--no-play",
                ]
            )
            if not out.is_file():
                raise RuntimeError("generation produced no file")
            self._path = out
            archive_song(out, seed=seed, title=title)
            elapsed = time.time() - (self._started_at or time.time())
            log(f'generation finished in {elapsed:.0f}s (seed {seed}, title "{title}")')
        except Exception as exc:  # noqa: BLE001
            self._error = str(exc)
            log(f"generation failed (seed {seed}): {exc}")
        finally:
            self._ready.set()

    def waiting_seconds(self) -> float:
        if self._started_at is None:
            return 0.0
        return time.time() - self._started_at

    def ready(self) -> bool:
        return self._ready.is_set()

    def result(self) -> Path:
        self._ready.wait()
        if self._error:
            raise RuntimeError(self._error)
        assert self._path is not None
        return self._path


def list_interstitials() -> list[Path]:
    files = [
        p
        for p in INTERSTITIALS.rglob("*.wav")
        if "piper-backup" not in p.parts
    ]
    if not files:
        raise RuntimeError(f"no interstitials under {INTERSTITIALS}")
    return files


def file_hash(path: Path) -> str:
    digest = hashlib.md5()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def load_catalog() -> dict:
    if CATALOG.is_file():
        return json.loads(CATALOG.read_text())
    return {"songs": []}


def find_library_song(md5: str) -> Path | None:
    for entry in load_catalog().get("songs", []):
        if entry.get("md5") != md5:
            continue
        path = ROOT / entry["path"]
        if path.is_file() and QUARANTINE not in path.parents:
            return path
    return None


def is_quarantined(path: Path) -> bool:
    try:
        path.resolve().relative_to(QUARANTINE.resolve())
        return True
    except ValueError:
        return False


def ensure_catalog_hashes() -> None:
    with _catalog_lock:
        catalog = load_catalog()
        changed = False
        for entry in catalog.get("songs", []):
            if entry.get("md5"):
                continue
            path = ROOT / entry["path"]
            if not path.is_file():
                continue
            entry["md5"] = file_hash(path)
            changed = True
        if changed:
            CATALOG.write_text(json.dumps(catalog, indent=2) + "\n")


def archive_song(src: Path, seed: int | None = None, title: str | None = None) -> Path:
    LIBRARY.mkdir(parents=True, exist_ok=True)
    md5 = file_hash(src)
    with _catalog_lock:
        existing = find_library_song(md5)
        if existing is not None:
            log(f"already saved {existing.relative_to(ROOT)}")
            return existing

        if title is not None and seed is not None:
            dest = LIBRARY / song_title.song_filename(title, seed)
        elif title is not None:
            dest = LIBRARY / f"{song_title.title_slug(title)}.wav"
        else:
            dest = LIBRARY / f"song-{datetime.now().strftime('%Y%m%d-%H%M%S')}.wav"
        shutil.copy2(src, dest)
        entry = {
            "path": str(dest.relative_to(ROOT)),
            "saved_at": datetime.now(timezone.utc).isoformat(),
            "duration_s": round(duration(dest), 3),
            "bytes": dest.stat().st_size,
            "md5": md5,
        }
        if seed is not None:
            entry["seed"] = seed
        if title is not None:
            entry["title"] = title
        catalog = load_catalog()
        catalog.setdefault("songs", []).append(entry)
        CATALOG.write_text(json.dumps(catalog, indent=2) + "\n")
    log(f"saved {dest.relative_to(ROOT)}")
    return dest


def import_staging_songs() -> int:
    imported = 0
    for src in sorted(STAGING.glob("pending-*.wav")):
        try:
            if duration(src) < MIN_LIBRARY_S:
                continue
        except (subprocess.CalledProcessError, ValueError, OSError):
            continue
        md5 = file_hash(src)
        if find_library_song(md5) is not None:
            continue
        archive_song(src)
        imported += 1
    return imported


def play_song(path: Path, tmp: Path) -> None:
    faded = tail_fade(path, tmp / "song-play.wav")
    play(faded)


def list_library_songs() -> list[Path]:
    if not LIBRARY.is_dir():
        return []
    songs = []
    for path in LIBRARY.glob("*.wav"):
        if is_quarantined(path):
            continue
        try:
            if duration(path) >= MIN_LIBRARY_S:
                songs.append(path)
        except (subprocess.CalledProcessError, ValueError, OSError):
            continue
    return sorted(songs)


def pick_library_song(exclude: Path | None = None) -> Path | None:
    library = list_library_songs()
    if exclude is not None and len(library) > 1:
        library = [p for p in library if p.resolve() != exclude.resolve()]
    if not library:
        return None
    return secrets.choice(library)


def play_song_pipeline(song: Path, gen: SongGenerator, tmp: Path) -> None:
    """Start generating the next song, then play this one."""
    gen.start()
    log("generating next song while current plays")
    play_song(song, tmp)


def bootstrap_first_song(gen: SongGenerator, tmp: Path) -> tuple[Path, bool]:
    """Returns (next song for main loop, already_played)."""
    gen.start()
    log("generating next song while current plays")
    warmup: Path | None = None
    pick = pick_library_song()
    if pick is not None:
        log(f"warm-up playback: {pick.relative_to(ROOT)} (first song generating)")
        warmup = tail_fade(pick, tmp / f"warmup-{int(time.time() * 1000)}.wav")
        play(warmup)
    else:
        log("no library songs yet — waiting for first generation…")

    if not gen.ready():
        log("first song still generating — fill until ready")
        return transition_with_fill(gen, tmp)

    nxt = gen.result()
    if warmup is not None:
        play_song_pipeline(nxt, gen, tmp)
        if gen.ready():
            log("next song ready immediately after warm-up")
            return gen.result(), True
        return transition_with_fill(gen, tmp)
    return nxt, False


def play_filler_then_song(last: Path, song: Path, gen: SongGenerator, tmp: Path) -> None:
    """Song transition after filler already played — do not crossfade (would replay filler)."""
    play_song_pipeline(song, gen, tmp)


def play_library_song_fill(gen: SongGenerator, tmp: Path) -> Path | None:
    """Play a full random library song (~2 min) while waiting for generation."""
    pick = pick_library_song()
    if pick is None:
        return None
    log(f"library track: {pick.relative_to(ROOT)}")
    faded = tail_fade(pick, tmp / f"library-fill-{int(time.time() * 1000)}.wav")
    play(faded, stop_if=gen.ready)
    if gen.ready():
        log("song ready — cutting library track short")
    return faded


def play_interstitial_clip(gen: SongGenerator, tmp: Path) -> Path:
    pool = list_interstitials()
    pick = random.choice(pool)
    rel = pick.relative_to(INTERSTITIALS)
    log(f"interstitial {rel}")
    faded = tail_fade(
        pick, tmp / f"inter-{int(time.time() * 1000)}.wav", INTERSTITIAL_FADE_MAX
    )
    play(faded, stop_if=gen.ready)
    if gen.ready():
        log("song ready — cutting interstitial short")
    return faded


def play_interstitial_phase(gen: SongGenerator, tmp: Path) -> Path | None:
    """Play interstitials for up to INTERSTITIAL_FILL_MAX_S, then stop."""
    last: Path | None = None
    phase_start = time.time()
    while not gen.ready() and (time.time() - phase_start) < INTERSTITIAL_FILL_MAX_S:
        last = play_interstitial_clip(gen, tmp)
        if gen.ready():
            break
    return last


def transition_with_fill(gen: SongGenerator, tmp: Path) -> tuple[Path, bool]:
    """Fill until the next song is ready; play it (filler already aired — no replay)."""
    log(f"waiting for song ({gen.waiting_seconds():.0f}s elapsed)…")
    last, nxt = play_wait_session(gen, tmp)
    if last is None:
        return nxt, False
    play_filler_then_song(last, nxt, gen, tmp)
    if gen.ready():
        log("next song ready after fill")
        return gen.result(), True
    log("still generating after song — more fill")
    return transition_with_fill(gen, tmp)


def play_wait_session(gen: SongGenerator, tmp: Path) -> tuple[Path | None, Path]:
    """Interstitials up to 40s, then a full library song; repeat until gen ready."""
    last: Path | None = None
    while not gen.ready():
        last = play_interstitial_phase(gen, tmp)
        if gen.ready():
            break
        log(
            f"interstitials hit {INTERSTITIAL_FILL_MAX_S:.0f}s — "
            "playing a full library track while generating"
        )
        library_last = play_library_song_fill(gen, tmp)
        if library_last is not None:
            last = library_last
        if gen.ready():
            break
    song = gen.result()
    return last, song


def main() -> int:
    if not CAPTION.is_file() or not LYRICS_TEMPLATE.is_file():
        log(f"missing prompts: {CAPTION} or {LYRICS_TEMPLATE}")
        return 1

    stop_stray_radio_processes()
    acquire_radio_lock()
    stop_playback()

    run([str(WARM), "start"])
    tmp = STAGING / "playback"
    tmp.mkdir(parents=True, exist_ok=True)
    ensure_catalog_hashes()
    imported = import_staging_songs()
    if imported:
        log(f"imported {imported} unstaged song(s) into library")

    gen = SongGenerator()

    song, skip_play = bootstrap_first_song(gen, tmp)

    while True:
        if not skip_play:
            play_song_pipeline(song, gen, tmp)
        else:
            skip_play = False

        if gen.ready():
            song = gen.result()
            log("next song ready — no wait session")
        else:
            log("next song still generating — fill until ready")
            song, skip_play = transition_with_fill(gen, tmp)

    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        log("stopped")
        stop_playback()
        release_radio_lock()
        raise SystemExit(0)
